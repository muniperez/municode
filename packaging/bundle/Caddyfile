{
    log {
        exclude http.log.error
    }
    on_demand_tls {
        ask http://workspace-gateway:8080/internal/certificate
    }
}

{$API_HOSTNAME} {
    encode zstd gzip
    @internal path /internal/workspace-gateway /internal/workspace-gateway/*
    respond @internal 404
    reverse_proxy api:8080
}

{$CONSOLE_HOSTNAME} {
    encode zstd gzip
    root * /srv/workspaces-dashboard
    header /settings/github/* {
        Referrer-Policy no-referrer
        Cache-Control no-store
    }
    try_files {path} /index.html
    file_server
}

https:// {
    tls {
        on_demand
    }
    @workspace host *.{$WORKSPACES_GATEWAY_DOMAIN}
    handle @workspace {
        reverse_proxy workspace-gateway:8080 {
            header_up X-Forwarded-Proto https
        }
    }
    handle {
        respond 404
    }
}
