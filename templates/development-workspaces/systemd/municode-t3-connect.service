[Unit]
Description=Loopback-only memory-only T3 Connect account enrollment
After=municode-t3.service
Requires=municode-t3.service
PartOf=municode-t3.service
ConditionPathIsDirectory=/workspace/t3

[Service]
ExecStart=/usr/bin/python3 -B /opt/municode-workspace/t3_connect.py serve
WorkingDirectory=/opt/municode-workspace
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/workspace /var/lib/municode-workspace
PrivateTmp=yes
ProtectHome=yes
KillMode=control-group
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
StandardOutput=null
StandardError=null
