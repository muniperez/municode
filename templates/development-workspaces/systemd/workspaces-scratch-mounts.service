[Unit]
Description=Bind git-ignored build outputs in /workspace/repos onto local scratch
After=workspaces-workspace.service workspaces-workspace-mount.service
Requires=workspaces-workspace-mount.service
Before=workspaces-t3.service workspaces-scratch-watch.service
ConditionPathIsDirectory=/workspace/repos

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/workspaces-workspace/scratch_mounts.py apply --budget-seconds 60
User=root
UMask=0077
TimeoutStartSec=100
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_SYS_PTRACE
StandardOutput=null
StandardError=journal
