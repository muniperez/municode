[Unit]
Description=Workspaces generation-fenced local workspace supervisor
After=local-fs.target
Requires=municodework.slice
ConditionPathExists=/etc/municode-workspace/runtime.json

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/municode-workspace/runtime.py serve
User=root
UMask=0077
RuntimeDirectory=municode-workspace
RuntimeDirectoryMode=0700
StateDirectory=municode-workspace
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
StandardOutput=null
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
