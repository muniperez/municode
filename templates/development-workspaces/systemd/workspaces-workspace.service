[Unit]
Description=Workspaces generation-fenced local workspace supervisor
After=local-fs.target
Requires=workspaceswork.slice
ConditionPathExists=/etc/workspaces-workspace/runtime.json

[Service]
Type=simple
ExecStart=/usr/bin/python3 -B /opt/workspaces-workspace/runtime.py serve
User=root
UMask=0077
RuntimeDirectory=workspaces-workspace
RuntimeDirectoryMode=0700
StateDirectory=workspaces-workspace
StateDirectoryMode=0700
Restart=on-failure
RestartSec=3
StandardOutput=null
StandardError=journal
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
