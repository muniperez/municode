[Unit]
Description=Bind git-ignored build outputs in /workspace/repos onto local scratch
After=municode-workspace.service municode-workspace-mount.service
Requires=municode-workspace-mount.service
Before=municode-t3.service municode-scratch-watch.service
ConditionPathIsDirectory=/workspace/repos

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/municode-workspace/scratch_mounts.py apply --budget-seconds 60
User=root
UMask=0077
TimeoutStartSec=100
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_SYS_PTRACE
StandardOutput=null
StandardError=journal
