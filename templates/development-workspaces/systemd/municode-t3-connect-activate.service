[Unit]
Description=Explicit generation-guarded restart of managed T3 for account enrollment

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/municode-workspace/t3_connect.py activate
WorkingDirectory=/opt/municode-workspace
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/workspace /var/lib/municode-workspace
PrivateTmp=yes
ProtectHome=yes
TimeoutStartSec=270
StandardOutput=null
StandardError=null
