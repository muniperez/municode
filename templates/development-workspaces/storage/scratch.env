# Workspaces storage tiers: caches and temporary files of the coding user (UID 2000) live on the
# VM's local scratch disk, never on the retained /workspace volume. This file is the single source
# for municode-t3.service (EnvironmentFile=), runtime tasks and /etc/profile.d/municode-scratch.sh.
# Plain KEY=/absolute/path lines only: no quotes, spaces or expansions.
XDG_CACHE_HOME=/var/lib/municode-scratch/cache
TMPDIR=/var/lib/municode-scratch/tmp
npm_config_cache=/var/lib/municode-scratch/cache/npm
pnpm_config_store_dir=/var/lib/municode-scratch/cache/pnpm/store
NUGET_PACKAGES=/var/lib/municode-scratch/cache/nuget/packages
NUGET_HTTP_CACHE_PATH=/var/lib/municode-scratch/cache/nuget/http-cache
PIP_CACHE_DIR=/var/lib/municode-scratch/cache/pip
UV_CACHE_DIR=/var/lib/municode-scratch/cache/uv
GOCACHE=/var/lib/municode-scratch/cache/go-build
GOMODCACHE=/var/lib/municode-scratch/cache/go-mod
PLAYWRIGHT_BROWSERS_PATH=/var/lib/municode-scratch/cache/ms-playwright
PYTHONPYCACHEPREFIX=/var/lib/municode-scratch/cache/pycache
